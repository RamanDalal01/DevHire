{
  "name": "devhire-monorepo",
  "version": "1.0.0",
  "description": "DevHire - Developer Job Board Platform Monorepo",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "concurrently \"node backend/server.js\" \"npm start --prefix frontend\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "author": "Raman Dalal",
  "license": "ISC"
}
